{
  "name": "shelfsense",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests next.config.ts postcss.config.mjs",
    "format:check": "prettier --check src scripts tests next.config.ts postcss.config.mjs",
    "dev:next": "next dev --webpack --hostname 127.0.0.1",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "seed": "node --conditions=react-server --import tsx scripts/maintenance.ts seed",
    "fixtures": "node --conditions=react-server --import tsx scripts/fixtures.ts",
    "reset-demo": "node --conditions=react-server --import tsx scripts/maintenance.ts reset-demo",
    "watch": "node --import tsx scripts/watch.ts",
    "backup": "node scripts/backup.mjs",
    "test:browser": "node --import tsx scripts/browser-smoke.ts",
    "migrate:media": "node --conditions=react-server --import tsx scripts/migrate-media.ts",
    "storage:cleanup": "node --conditions=react-server --import tsx scripts/cleanup-storage.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@vercel/blob": "^2.8.1",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "jest": "^30.5.2"
  },
  "type": "module"
}
