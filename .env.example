# Node PostgreSQL URL; use your provider's pooled endpoint on Vercel.
DATABASE_URL=postgresql://shelfsense:change-me@127.0.0.1:5433/shelfsense
# Separate database name; test runners create and remove disposable schemas.
TEST_DATABASE_URL=postgresql://shelfsense:change-me@127.0.0.1:5433/shelfsense_test
# Optional managed media directory; defaults to ./media.
# MEDIA_DIR=/absolute/path/to/media
# Hosted environments require a PRIVATE Blob store and operator credentials.
# BLOB_READ_WRITE_TOKEN=
# UPLOAD_SIGNING_SECRET=generate-a-long-random-secret
# OPERATOR_USERNAME=
# OPERATOR_PASSWORD=
# Optional Node folder uploader: Basic followed by base64(username:password).
# SHELFSENSE_AUTHORIZATION=
